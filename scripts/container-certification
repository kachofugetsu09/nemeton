#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

pnpm --dir webui install --frozen-lockfile
pnpm --dir webui lint
pnpm --dir webui build
NEMETON_PLAYWRIGHT_BUNDLED=1 pnpm --dir webui test:e2e
go vet ./...
go test -count=1 -race ./...
go build ./cmd/nemeton ./cmd/nemetond
